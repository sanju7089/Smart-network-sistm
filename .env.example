# ==========================================
# SMART WORK NETWORK - ENVIRONMENT
# ==========================================

# development | test | production
NODE_ENV=development

# ==========================================
# SERVER
# ==========================================

PORT=3000

# ==========================================
# DATABASE
# ==========================================

MONGODB_URI=

# ==========================================
# AUTHENTICATION
# ==========================================

JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# CORS
# ==========================================

# Comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ==========================================
# FRONTEND
# ==========================================

# Password reset link will be generated from this.
#
# Development:
# http://localhost:5500
#
# Production:
# https://your-production-domain.com

FRONTEND_URL=http://localhost:5500

# ==========================================
# PASSWORD RESET
# ==========================================

# Reset link lifetime in minutes.
PASSWORD_RESET_EXPIRES_MINUTES=15

# ==========================================
# EMAIL / RESEND
# ==========================================

# Resend API key
RESEND_API_KEY=

# Example:
# Smart Work Network <noreply@yourdomain.com>
EMAIL_FROM=

# ==========================================
# RAZORPAY
# ==========================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYMENT_CURRENCY=INR
